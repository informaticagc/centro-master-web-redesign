# Copia este archivo a .env (NUNCA subas .env real a Git) y rellena los
# valores reales. .env está en .gitignore — ver admin/README.md.

# --- Obligatorias ---
ADMIN_USERNAME=secretaria
# Genera el hash con: node admin/scripts/hash-password.js "tu-contraseña"
ADMIN_PASSWORD_HASH=
# Cadena aleatoria larga, distinta en cada instalación. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Opcionales (valores por defecto seguros ya aplicados) ---
# Solo cambiar a una IP de red local si de verdad se quiere exponer el panel
# fuera de este equipo — hazlo con conocimiento de causa, no hay HTTPS propio.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4000

# Pon esto en "true" únicamente si el panel se sirve detrás de HTTPS real
# (p.ej. un proxy inverso). Con HTTPS activo, el navegador no reenviará la
# cookie de sesión por HTTP plano si esto está en true.
ADMIN_COOKIE_SECURE=false

# Minutos de inactividad antes de que la sesión expire.
ADMIN_SESSION_MAX_AGE_MIN=60

# Intentos de login fallidos permitidos antes de bloquear temporalmente esa
# combinación usuario+IP, y minutos de bloqueo.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_MIN=15

# Mientras sea "true" (por defecto), "Publicar en web de pruebas" simula
# todo el proceso (validación, build, comprobaciones Git, mensaje de commit)
# SIN ejecutar commit ni push reales. Cambiar a "false" solo cuando se haya
# revisado y aprobado el flujo, y siempre con confirmación explícita del
# responsable del proyecto antes de la primera publicación real.
ADMIN_PUBLISH_DRY_RUN=true
